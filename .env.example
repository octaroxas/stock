# Variáveis lidas pelos docker-compose.yml (produção) e docker-compose.dev.yml (dev) da raiz.
# Copie para .env antes de rodar `docker compose up`.

# Produção — domínio público, cadastrado no Nginx Proxy Manager (Forward Hostname stock-web,
# porta 80). OBRIGATÓRIO: o compose falha sem ele. O container não publica porta no host;
# crie a rede uma única vez: `docker network create npm`.
WEB_DOMAIN=stock.octacilio.dev.br

# Dev — porta do host: http://localhost:${WEB_PORT}
WEB_PORT=8080
