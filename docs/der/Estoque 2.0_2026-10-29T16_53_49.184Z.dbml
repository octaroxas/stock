Table tenants [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	name varchar(255) [ not null ]
}

Table units [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	name varchar(255) [ not null ]
	tenant_id integer [ not null ]
}

Table users [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	name varchar(255) [ not null ]
	tenant_id integer [ not null ]
	login varchar(255) [ not null ]
	password varchar(255) [ not null ]
	is_active boolean [ not null ]
}

Table roles [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	tenant_Id integer [ not null ]
	name varchar(255) [ not null ]
	guard_name varchar(255) [ not null ]
}

Table unit_users [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	unit_id integer [ not null ]
	user_id integer [ not null ]
}

Table order [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	tenant_id integer [ not null ]
	created_at timestamp [ not null ]
	requester_user_id integer [ not null ]
	requester_unit_id integer [ not null ]
	justification text [ not null ]
	order_status_id integer [ not null ]
	evaluating_manager_user_id integer [ not null ]
	evaluating_date timestamp [ not null ]
	obervations text [ not null ]
}

Table order_registers [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	order_id integer
}

Table permissions [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	name varchar(255) [ not null ]
	role_id integer
}

Table products [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	description text [ not null ]
	mensurement_id integer [ not null ]
	min_stock integer [ not null ]
	max_stock integer [ not null ]
	location_id integer [ not null ]
	is_active boolean
}

Table measurements [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	name varchar(255) [ not null ]
}

Table locations [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	name varchar(255)
}

Table current_stock [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	product_id integer [ not null ]
	current_quantity integer [ not null ]
	last_update timestamp [ not null ]
}

Table movements [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	date_time timestamptz [ not null ]
	type varchar(255) [ not null ]
	origin_id integer
	product_Id integer
	quantity integer
	responsible_user_id integer
	reference text
}

Table origins [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	name varchar(255)
}

Table order_status [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	name varchar(255) [ not null ]
}

Table order_items [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	order_id integer [ not null ]
	product_id integer [ not null ]
	requested_quantity integer [ not null ]
	approved_quantity integer [ not null ]
	distributed_quantity integer [ not null ]
	observations text
}

Ref {
	units.tenant_id > tenants.id [ delete: no action, update: no action ]
}

Ref {
	tenants.id < users.tenant_id [ delete: no action, update: no action ]
}

Ref {
	users.id < unit_users.user_id [ delete: no action, update: no action ]
}

Ref {
	units.id < unit_users.unit_id [ delete: no action, update: no action ]
}

Ref {
	tenants.id < order.tenant_id [ delete: no action, update: no action ]
}

Ref {
	order.id < order_registers.order_id [ delete: no action, update: no action ]
}

Ref fk_roles_id_permissions {
	roles.id < permissions.role_id [ delete: no action, update: no action ]
}

Ref fk_measurements_id_products {
	measurements.id < products.mensurement_id [ delete: no action, update: no action ]
}

Ref fk_locations_id_products {
	locations.id < products.location_id [ delete: no action, update: no action ]
}

Ref fk_products_id_current_stock {
	products.id - current_stock.product_id [ delete: no action, update: no action ]
}

Ref fk_origins_id_movements {
	origins.id < movements.origin_id [ delete: no action, update: no action ]
}

Ref fk_movements_product_Id_products {
	movements.product_Id > products.id [ delete: no action, update: no action ]
}

Ref fk_movements_responsible_user_id_users {
	movements.responsible_user_id > users.id [ delete: no action, update: no action ]
}

Ref fk_order_status_id_order {
	order_status.id < order.order_status_id [ delete: no action, update: no action ]
}

Ref fk_order_id_order_items {
	order.id < order_items.order_id [ delete: no action, update: no action ]
}